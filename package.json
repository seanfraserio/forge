{
  "name": "forge-ai",
  "version": "0.2.7",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/seanfraserio/forge.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "eslint packages/*/src --ext .ts",
    "typecheck": "pnpm -r run typecheck",
    "dev": "pnpm -r --parallel run dev",
    "clean": "find . -name dist -type d | xargs rm -rf"
  },
  "pnpm": {
    "overrides": {
      "flatted": ">=3.4.2",
      "picomatch": ">=4.0.4",
      "source-map-js": ">=1.2.2",
      "tinypool": ">=2.1.1",
      "js-yaml": "4.3.2",
      "brace-expansion@^1": "1.1.21",
      "brace-expansion@^2": "2.1.7",
      "postcss": "8.5.23",
      "nanoid@^3": "3.3.18",
      "vite": "6.4.5"
    }
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.6"
  }
}
