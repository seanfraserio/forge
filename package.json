{
  "name": "forge-ai",
  "version": "0.3.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/seanfraserio/forge.git"
  },
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "eslint packages/*/src --ext .ts",
    "typecheck": "pnpm -r run typecheck",
    "dev": "pnpm -r --parallel run dev",
    "clean": "find . -name dist -type d | xargs rm -rf",
    "check:toolchain": "node scripts/check-toolchain.mjs"
  },
  "pnpm": {
    "overrides": {
      "flatted@^3.0.0": "3.4.4",
      "picomatch@^2.0.0": "2.3.2",
      "picomatch@^4.0.0": "4.0.7",
      "yaml@^2.0.0": "2.9.1",

      "vite@7.3.7>esbuild": "0.28.2",
      "postcss@^8.0.0": "8.5.29",
      "nanoid@^3.0.0": "3.3.18",
      "source-map-js@^1.0.0": "1.2.2",
      "brace-expansion@^1.0.0": "1.1.21"
    }
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.13.0",
    "prettier": "^3.2.0",
    "tsup": "8.5.1",
    "typescript": "^5.4.0",
    "vitest": "4.1.12",
    "vite": "7.3.7",
    "@eslint/js": "10.0.1",
    "globals": "^16.0.0"
  }
}
